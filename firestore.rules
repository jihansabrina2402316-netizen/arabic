rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jihansabrina291006@gmail.com' ||
        request.auth.token.email == 'jihan.sabrina.2402316@students.um.ac.id'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 128 &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student' || isAdmin());
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email'])) ) || isAdmin();
      allow delete: if isAdmin();

      // Progress subcollection per user
      match /progress/{progressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) && request.resource.data.userId == userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Custom learning materials created by teachers/admin
    match /custom_materials/{materialId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
